<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                    <p>
                        <strong>Organization:</strong>
                        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                    </p>
                    <p><%= project.description %></p>
                    <p>
                        <strong>Location:</strong> <%= project.location %><br>
                        <strong>Date:</strong> <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                    </p>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No service projects are available right now.</p>
    <% } %>
</main>
<%- include('partials/footer') %>