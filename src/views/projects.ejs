<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>

    <% if (projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <h3><%= project.title %></h3>
                    <p><%= project.description %></p>
                    <p>
                        <strong>Location:</strong> <%= project.pr_location %><br>
                        <strong>Date:</strong> <%= new Date(project.pr_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                    </p>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No service projects are available right now.</p>
    <% } %>
</main>
<%- include('partials/footer') %>